function doOptions(e) {
  return ContentService
    .createTextOutput("")
    .setMimeType(ContentService.MimeType.TEXT);
}

function doGet(e) {
  try {
    const p = (e && e.parameter) || {};

    const operacao = String(p.operacao || p.op || "").trim().toLowerCase();
    const email = String(p.email || "").trim().toLowerCase();

    if (operacao === "gerar_relatorio_faculdade" || operacao === "gerar_relatorio") {
      return jsonp_(gerarRelatorioFaculdade_(e), e);
    }

    if (operacao === "enviar_relatorio_dc") {
      return jsonp_(enviarRelatorioDc_(p), e);
    }

    if (!email) {
      return jsonp_({ sucesso: false, httpStatus: 400, mensagem: "Email não enviado (use ?email=...)." }, e);
    }

    const nomeSheet = getSheetByEmail_(email);
    if (!nomeSheet) {
      return jsonp_({ sucesso: false, httpStatus: 403, mensagem: "Email sem permissão." }, e);
    }

    // DC: só pode listar relatórios
    if (operacao === "listar_relatorios_dc") {
      if (nomeSheet !== "__DC__") {
        return jsonp_({ sucesso: false, httpStatus: 403, mensagem: "Email sem permissão." }, e);
      }
      return jsonp_(listarRelatoriosDc_(), e);
    }

    if (nomeSheet === "__DC__") {
      return jsonp_({ sucesso: false, httpStatus: 403, mensagem: "A conta DC só pode usar a operação listar_relatorios_dc." }, e);
    }

    const ss = SPREADSHEET_ID
      ? SpreadsheetApp.openById(SPREADSHEET_ID)
      : SpreadsheetApp.getActiveSpreadsheet();

    const sh = ss.getSheetByName(nomeSheet);
    if (!sh) {
      return jsonp_({ sucesso: false, httpStatus: 404, mensagem: `Sheet '${nomeSheet}' não existe.` }, e);
    }

    const lastRow = sh.getLastRow();
    if (lastRow < 2) {
      return jsonp_({
        sucesso: true,
        httpStatus: 200,
        sheet: nomeSheet,
        faculdadeCodigo: nomeSheet,
        faculdadeNome: getNomeFaculdadeByEmail_(email),
        filtro: null,
        total: 0,
        dados: []
      }, e);
    }

    const estadoFiltro = String(p.estado || "").trim();
    const idxEstado = COLS.indexOf("estado");

    const values = sh.getRange(2, 1, lastRow - 1, COLS.length).getValues();

    const dados = values
      .filter(r => r.some(v => v !== "" && v !== null))
      .filter(r => {
        if (!estadoFiltro || idxEstado < 0) return true;
        const estadoLinha = String(r[idxEstado] ?? "").trim();
        return estadoLinha.localeCompare(estadoFiltro, undefined, { sensitivity: "accent" }) === 0;
      })
      .map(rowToObj_);

    return jsonp_({
      sucesso: true,
      httpStatus: 200,
      sheet: nomeSheet,
      faculdadeCodigo: nomeSheet,
      faculdadeNome: getNomeFaculdadeByEmail_(email),
      filtro: estadoFiltro ? { estado: estadoFiltro } : null,
      total: dados.length,
      dados
    }, e);

  } catch (err) {
    return jsonp_({
      sucesso: false,
      httpStatus: 500,
      mensagem: String(err?.message || err)
    }, e);
  }
}

function gerarRelatorioFaculdade_(e) {
  const p = (e && e.parameter) || {};

  const porPeriodo = String(p.porPeriodo || "").trim().toLowerCase() === "true";
  const opcao = String(p.tipoRelatorio || p.opcao || "Todas").trim();
  const formato = String(p.formato || "pdf").trim().toLowerCase();
  const dataInicio = porPeriodo ? String(p.dataInicio || "").trim() : "";
  const dataFim = porPeriodo ? String(p.dataFim || "").trim() : "";
  const email = String(p.email || "").trim().toLowerCase();

  return gerarRelatorio({
    operacao: "gerar_relatorio_faculdade",
    email,
    formato,
    opcao,
    porPeriodo,
    dataInicio,
    dataFim,
    titulo: String(p.titulo || "Relatório de Actividades").trim()
  });
}





function listarRelatoriosDc_() {
  const ss = SPREADSHEET_ID
    ? SpreadsheetApp.openById(SPREADSHEET_ID)
    : SpreadsheetApp.getActiveSpreadsheet();

  const sh = ss.getSheetByName("Relatorios");
  if (!sh) throw new Error("Sheet 'Relatorios' não existe.");

  const lastRow = sh.getLastRow();
  if (lastRow < 2) {
    return { sucesso: true, total: 0, dados: [] };
  }

  const tz = Session.getScriptTimeZone();
  const values = sh.getRange(2, 1, lastRow - 1, 3).getValues(); // A2:C

  const dados = values
    .filter(r => r.some(v => v !== "" && v !== null))
    .map((r, i) => {
      const unidade = String(r[0] || "").trim();
      const url = String(r[1] || "").trim();

      const dt = r[2];
      const dataEnvio = dt instanceof Date
        ? Utilities.formatDate(dt, tz, "dd-MM-yy")
        : String(dt || "").trim();

      return {
        ord: i + 1,
        unidadeOrganica: unidade,
        url: url,
        enviado: !!url,
        dataEnvio: url ? (dataEnvio || "") : "" // se não enviado, deixa vazio
      };
    });

  return {
    sucesso: true,
    total: dados.length,
    dados
  };
}




/** ===================== Helpers ===================== **/

function rowToObj_(row) {
  const o = {};
  for (let i = 0; i < COLS.length; i++) {
    o[COLS[i]] = formatValue_(row[i]);
  }
  return o;
}

function formatValue_(v) {
  // Converte Date para ISO (YYYY-MM-DD) para o front filtrar mais fácil
  if (v instanceof Date && !isNaN(v.getTime())) {
    const y = v.getFullYear();
    const m = String(v.getMonth() + 1).padStart(2, "0");
    const d = String(v.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
  }
  return v;
}

function jsonCore_(obj, statusCode) {
  obj.httpStatus = statusCode;

  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}







